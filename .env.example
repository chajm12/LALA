# Required for styling analysis, planning, evaluation, and Vision verification.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PLAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_AGENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_VISION_MODEL=moonshotai/kimi-k3
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Required only for the current lookbook image generation and legacy shopping search.
OPENAI_API_KEY=
OPENAI_SHOPPING_MODEL=gpt-5.4-mini
OPENAI_TREND_MODEL=gpt-5.4-mini

# Optional: set this to http://localhost:8000 when the NAT server is running.
NAT_WORKFLOW_URL=
DDP_APP_URL=http://localhost:3000
