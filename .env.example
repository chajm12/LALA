# NVIDIA NIM (build.nvidia.com 에서 발급, nvapi- 로 시작)
NVIDIA_API_KEY=
# 예선: 호스팅 엔드포인트 / 본선: 자체 NIM 컨테이너 (예: http://localhost:8000/v1)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# 역할별 모델 (기본값은 src/lib/nim.ts 참고, 바꾸고 싶을 때만 지정)
# NIM_PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_JUDGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# 룩북 이미지 생성 제공자: nvidia | openai
IMAGE_PROVIDER=nvidia
# IMAGE_PROVIDER=openai 일 때만 필요
OPENAI_API_KEY=

# IMAGE_PROVIDER=nvidia 일 때: build.nvidia.com 로그인 → 이미지 모델 Playground → 코드 보기에서 invoke URL 복사
NVIDIA_IMAGE_INVOKE_URL=
# 모델별 추가 파라미터 (선택) 예: {"steps":30,"cfg_scale":5}
NVIDIA_IMAGE_EXTRA_JSON=
